// Put in ~/.config/opencode/opencode.json (global, per user, NEVER in the repo).
// Replace baseURL with your gateway. The key comes from the environment variable GATEWAY_API_KEY.
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Greg": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Team gateway",
      "options": { "baseURL": "https://YOUR-GATEWAY.example/v1", "apiKey": "{env:GATEWAY_API_KEY}" },
      "models": {
        "gpt-6-astra": { "name": "gpt-6-astra" },
        "kimi-k3": { "name": "kimi-k3" },
        "deepseek-v4-pro": { "name": "deepseek-v4-pro" },
        "deepseek-v4-flash": { "name": "deepseek-v4-flash" },
        "glm-5.2": { "name": "glm-5.2" }
      }
    }
  }
}
