#!/bin/sh
# 1) Local safety net: refuse pushes to main/master (works even if GitHub branch protection is unavailable
#    on a private free-plan repo). Creating the branch the first time (remote sha all zeros) is allowed
#    so the initial bootstrap push works. Humans-only emergency override: RR_ALLOW_MAIN_PUSH=1 git push ...
# 2) Git LFS pre-push: because core.hooksPath points here, git-lfs cannot install its own hook, so we call it.
# Enable once per clone:  git config core.hooksPath scripts/hooks
command -v git-lfs >/dev/null 2>&1 || { echo "pre-push: git-lfs not found on PATH (install Git LFS)." >&2; exit 2; }
zero=0000000000000000000000000000000000000000
input=$(cat)
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$remote_sha" != "$zero" ] && [ "${RR_ALLOW_MAIN_PUSH:-0}" != "1" ]; then
        echo "pre-push: direct push to ${remote_ref#refs/heads/} is blocked. Use a branch + PR (docs/12)." >&2
        blocked=1
      fi
      ;;
  esac
done <<HOOK_INPUT
$input
HOOK_INPUT
[ "$blocked" = "1" ] && exit 1
printf '%s\n' "$input" | git lfs pre-push "$@"
